DATABASE_URL=postgresql://prudens:prudens@localhost:5432/prudens_index
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
# Optional: comma-separated extra origins (e.g. http://192.168.0.185:3000)
CLERK_SECRET_KEY=sk_test_
# S3 API endpoint (Cloudflare dashboard → R2 → Overview → S3 API)
# Example: https://abc123def456.r2.cloudflarestorage.com
# NOT the public bucket URL (*.r2.dev) — that breaks browser uploads (SSL error)
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=prudens-uploads
# R2 bucket CORS (dashboard): allow PUT from http://localhost:3000, header Content-Type
PORT=3001
SEED_ADMIN_CLERK_ID=
SEED_CLIENT_CLERK_ID=
CLERK_INVITE_REDIRECT_URL=http://localhost:3000/sign-up